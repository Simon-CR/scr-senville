# Copy this file to secrets.yaml and fill in your credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
fallback_ap_password: "senville-fallback-pw"

# Generate a 32-byte base64 key at https://esphome.io/components/api.html
api_encryption_key: "YOUR_32_BYTE_BASE64_API_KEY="
ota_password: "YOUR_OTA_PASSWORD"

# MQTT Broker Settings (Home Assistant Mosquitto / EMQX)
mqtt_broker: "192.0.2.50"
mqtt_username: "mqtt_user"
mqtt_password: "mqtt_password"
